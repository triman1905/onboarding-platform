# Backend port (Express API)
PORT=3001

# Gmail SMTP credentials — use a Google App Password, NEVER your account password.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Local SQLite database file
DATABASE_PATH=./data/vanguard.sqlite

# Frontend origin (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Test mode banner in the UI (set to false once you go beyond test recipients)
TEST_MODE=true

# ---------------------------------------------------------------------------
# Twilio — WhatsApp + SMS automation (see README "Twilio setup" section)
# ---------------------------------------------------------------------------
# Account SID starts with "AC…", Auth Token is the 32-char hex string next to
# it on the Twilio Console dashboard. Do NOT confuse the Auth Token with a
# Content Template SID (which starts with "HX…") — that is a different value.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp Sandbox (or approved production sender), e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Twilio SMS-capable number, e.g. +14155551234
TWILIO_SMS_FROM=

# Master + per-channel switches — set to false to disable without removing credentials.
TWILIO_ENABLED=true
WHATSAPP_ENABLED=true
SMS_ENABLED=true

# Optional: public HTTPS URL for POST /api/communications/twilio/status
# (delivery status webhook). Leave unset to skip delivery-status callbacks —
# sends still work, they just stay at "SENT" instead of advancing to
# DELIVERED/READ/FAILED.
TWILIO_STATUS_CALLBACK_URL=

# Optional: Twilio Content API template SIDs for WhatsApp, required once you
# move off the Sandbox / outside a 24h session window. One per message type.
TWILIO_WHATSAPP_CONTENT_SID_WELCOME=
TWILIO_WHATSAPP_CONTENT_SID_REMINDER=
